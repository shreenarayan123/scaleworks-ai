      "updated": 1763511043962,
      "locked": false,
      "text": "BACKEND\n\nNode.js + Express + TypeScript\n\nAPI: /jobs, /jobs/:id,\n     /audio, /rep-speaker\n\nPipeline stages:\nuploaded → transcribing →\nscoring_tone → analyzing →\ndone / failed\n\nOrchestrates transcription,\nemotion scoring and LLM calls",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BACKEND\n\nNode.js + Express + TypeScript\n\nAPI: /jobs, /jobs/:id,\n     /audio, /rep-speaker\n\nPipeline stages:\nuploaded → transcribing →\nscoring_tone → analyzing →\ndone / failed\n\nOrchestrates transcription,\nemotion scoring and LLM calls",
      "autoResize": true,
      "lineHeight": 1.25
    },
