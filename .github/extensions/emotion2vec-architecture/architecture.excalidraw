      "boundElements": [],
      "updated": 1795430000000,
      "locked": false,
      "text": "EMOTION SERVICE\n\nFastAPI + FunASR\nemotion2vec_plus_base (CPU)\n\nCalls >5.5 min: silence-aligned\n~5 min chunks (about 11?12/hour)\n\nRep-only speech segments\n(1.5?10 s) scored concurrently\n(default 3; configurable)\nFailed stage recomputes chunks",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EMOTION SERVICE\n\nFastAPI + FunASR\nemotion2vec_plus_base (CPU)\n\nCalls >5.5 min: silence-aligned\n~5 min chunks (about 11?12/hour)\n\nRep-only speech segments\n(1.5?10 s) scored concurrently\n(default 3; configurable)\nFailed stage recomputes chunks",
      "autoResize": true,
      "lineHeight": 1.25
    },
