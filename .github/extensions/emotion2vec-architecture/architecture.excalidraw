      "boundElements": [],
      "updated": 1795430000000,
      "locked": false,
      "text": "BACKEND API + WORKER\n\nNode.js + Express + TypeScript\n\nUpload limit: ? 1 hour / 200 MB\nFFprobe validates; FFmpeg makes\n16 kHz mono Opus copy for Scribe\n\nPipeline: whole-call transcription\n? rep selection ? tone analysis\n\nHeartbeat every 10 s; stale-job\nrecovery after 60 s; checkpoints",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BACKEND API + WORKER\n\nNode.js + Express + TypeScript\n\nUpload limit: ? 1 hour / 200 MB\nFFprobe validates; FFmpeg makes\n16 kHz mono Opus copy for Scribe\n\nPipeline: whole-call transcription\n? rep selection ? tone analysis\n\nHeartbeat every 10 s; stale-job\nrecovery after 60 s; checkpoints",
      "autoResize": true,
      "lineHeight": 1.25
    },
