      "boundElements": [],
      "updated": 1763511043962,
      "locked": false,
      "text": "FRONTEND\n\nReact 19 + TanStack Router\nTanStack Query\nVite / TypeScript\n\n• Upload .wav calls\n• Poll job progress\n• Review transcript\n• Show tone, evidence,\n  action items and flags",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FRONTEND\n\nReact 19 + TanStack Router\nTanStack Query\nVite / TypeScript\n\n• Upload .wav calls\n• Poll job progress\n• Review transcript\n• Show tone, evidence,\n  action items and flags",
      "autoResize": true,
      "lineHeight": 1.25
    },
