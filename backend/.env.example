# Postgres on Neon (Dashboard -> Connect -> connection string, with ?sslmode=require)
DATABASE_URL=

# ElevenLabs Scribe speech-to-text
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v3
# Per-Scribe request deadline. Undici's header/body timers are set slightly higher.
SCRIBE_TIMEOUT_MS=1200000

# Per-emotion-chunk request deadline (CPU emotion2vec can take several minutes).
EMOTION_TIMEOUT_MS=1200000
# Chunks processed in parallel. Must be <= EMOTION_INFERENCE_CONCURRENCY in the
# emotion service. 1 is safest on a small CPU; 3 suits a 4+ core machine.
EMOTION_CONCURRENCY=3

# Worker lease: heartbeat refresh and the age at which a job is reclaimable.
HEARTBEAT_INTERVAL_MS=10000
STALE_HEARTBEAT_MS=60000

# GLM 5.3 (OpenAI-compatible API)
GLM_BASE_URL=https://api.experientiallabs.ai/v1
GLM_MODEL=glm-5.3-flash-uncensored
GLM_API_KEY=

# Private emotion service (only this backend calls it)
EMOTION_SERVICE_URL=http://127.0.0.1:8001

PORT=4000
UPLOAD_DIR=uploads
CORS_ORIGIN=*

# true = canned Scribe + GLM responses so the pipeline runs without API keys
MOCK_EXTERNAL=false
