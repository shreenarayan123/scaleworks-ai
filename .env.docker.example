# Copy to .env.docker on the server, then replace every placeholder.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?sslmode=require
ELEVENLABS_API_KEY=replace-me
GLM_BASE_URL=https://your-openai-compatible-endpoint/v1
GLM_MODEL=your-model-name
GLM_API_KEY=replace-me
EMOTION_SERVICE_TOKEN=replace-with-a-long-random-secret
# Parallel emotion chunks in the backend; must be <= the service semaphore.
EMOTION_CONCURRENCY=3
EMOTION_INFERENCE_CONCURRENCY=3
# App limits and long-job timeouts (milliseconds except size/duration).
MAX_DURATION_SEC=3600
MAX_FILE_SIZE_BYTES=209715200
SCRIBE_TIMEOUT_MS=1200000
EMOTION_TIMEOUT_MS=1200000
HEARTBEAT_INTERVAL_MS=10000
STALE_HEARTBEAT_MS=60000
CORS_ORIGIN=https://your-vercel-domain.example
BACKEND_PORT=8080
